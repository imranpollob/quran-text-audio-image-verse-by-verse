{
  "surah_number": 112,
  "surah_name": "সূরা আল এখলাস",
  "revelation_place": "মক্কায় অবতীর্ণ",
  "total_ayah": 4,
  "total_ruku": 1,
  "ayahs": [
    {
      "ayah_number": 1,
      "bangla": "(হে মোহাম্মদ,) তুমি বলো, তিনিই আল্লাহ, (তিনি) একক,"
    },
    {
      "ayah_number": 2,
      "bangla": "আল্লাহ তায়ালা হচ্ছেন সম্পূর্ণ অমুখাপেক্ষী,"
    },
    {
      "ayah_number": 3,
      "bangla": "তাঁর থেকে কেউ জন্ম নেয়নি, আর তিনিও কারো থেকে জন্ম গ্রহণ করেননি,"
    },
    {
      "ayah_number": 4,
      "bangla": "আর তাঁর সমতুল্য দ্বিতীয় কেউ-ই নেই।"
    }
  ]
}
